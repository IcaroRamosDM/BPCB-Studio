{
  "format": "bpcb.studio",
  "schema": 1,
  "board": {
    "id": "comunicacao_studio_uart",
    "pcb": "Comunicação Studio UART",
    "revision": "V1",
    "version": "1.0.0",
    "author": "",
    "connections": "SIMULAÇÃO INICIAL. Confira o módulo, a alimentação, a pinagem e os níveis antes de adaptar para hardware. O exemplo não aprova a placa nem inicializa módulos desconhecidos.",
    "notes": "",
    "session_title": "Roteiro da bancada",
    "session_order": ""
  },
  "components": [],
  "devices": [],
  "signals": [],
  "tests": [
    {
      "id": "transferencia",
      "title": "Exemplo UART",
      "purpose": "",
      "instructions": "O projeto começa em simulação. Para hardware, escolha o adaptador no BPCB, confira as conexões e só então altere o modo do teste no Studio. ESP-AT ou Bluetooth em modo AT, sem eco: AT + CRLF e exemplo OK + CRLF. Baud, modo, eco e sintaxe variam; adapte ao manual. Wi-Fi também pode usar SPI ou outro protocolo conforme o módulo.",
      "expected": "Conferir os bytes e a resposta de exemplo.",
      "timeout": 300,
      "mode": "simulation",
      "comm_enabled": true,
      "comm_bus": "uart",
      "comm_adapters": "serial,ch340,cp2102,ft232rl,ft232h,mcp2221a,ch347",
      "comm_min_hz": 20000,
      "comm_max_hz": 400000,
      "comm_max_transfer": 64,
      "comm_timeout_ms": 3000,
      "require_calibration": false,
      "simulation_fault": "none",
      "simulation_at": "",
      "parameters": [],
      "formulas": [],
      "steps": [
        {
          "id": "bytes",
          "title": "Transferência UART",
          "type": "communication",
          "message": "Confira as conexões antes de continuar.",
          "variable": "resposta",
          "signal": "",
          "device": "",
          "expression": "0",
          "unit": "V",
          "min": 0,
          "max": 5,
          "seconds": 0.2,
          "timeout": 60,
          "sample": 1,
          "operator": "gt",
          "right": "0",
          "target": "",
          "reference": "",
          "tolerance_pct": 5,
          "tolerance_abs": 0,
          "repeat_limit": 10,
          "comm_bus": "uart",
          "comm_encoding": "ascii",
          "comm_write": "AT",
          "comm_ending": "crlf",
          "comm_read": 4,
          "comm_address": 72,
          "comm_expect": "4F 4B 0D 0A",
          "comm_mask": "",
          "comm_register": "dr",
          "comm_bits": 8,
          "comm_idle": 0,
          "comm_ir_bits": 0,
          "comm_ir_write": "",
          "comm_decode": "count",
          "comm_simulated": "4F 4B 0D 0A",
          "display_unit": "",
          "source": "manual",
          "rigol_channel": "1",
          "rigol_metric": "VAVG",
          "record_reading": false,
          "plot": false,
          "plot_target": "",
          "plot_limit": "",
          "samples": 1,
          "interval_ms": 50,
          "stable_count": 1
        },
        {
