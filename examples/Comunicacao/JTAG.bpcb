{
  "format": "bpcb.studio",
  "schema": 1,
  "board": {
    "id": "comunicacao_studio_jtag",
    "pcb": "Comunicação Studio JTAG",
    "revision": "V1",
    "version": "1.0.0",
    "author": "",
    "connections": "SIMULAÇÃO INICIAL. Confira o módulo, a alimentação, a pinagem e os níveis antes de adaptar para hardware. O exemplo não aprova a placa nem inicializa módulos desconhecidos.",
    "notes": "",
    "session_title": "Roteiro da bancada",
    "session_order": ""
  },
  "components": [],
  "devices": [],
  "signals": [],
  "tests": [
    {
      "id": "transferencia",
      "title": "Exemplo JTAG",
      "purpose": "",
      "instructions": "O projeto começa em simulação. Para hardware, escolha o adaptador no BPCB, confira as conexões e só então altere o modo do teste no Studio. Leitura bruta de 32 bits DR após o reset TAP da abertura. A resposta simulada é ilustrativa. Uma cadeia com BYPASS ou vários TAPs exige comprimentos/instruções próprios. Use o explorador JTAG do BPCB para analisar a cadeia antes.",
      "expected": "Conferir os bytes e a resposta de exemplo.",
      "timeout": 300,
      "mode": "simulation",
      "comm_enabled": true,
      "comm_bus": "jtag",
      "comm_adapters": "ch347",
      "comm_min_hz": 1875000,
      "comm_max_hz": 30000000,
      "comm_max_transfer": 64,
      "comm_timeout_ms": 3000,
      "require_calibration": false,
      "simulation_fault": "none",
      "simulation_at": "",
      "parameters": [],
      "formulas": [],
