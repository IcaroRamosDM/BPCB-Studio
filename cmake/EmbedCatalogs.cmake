# Keep editable catalog data in JSON and embed it without adding a runtime dependency.
function(bs_catalog_string json output)
    string(REPLACE "\\" "\\\\" literal "${json}")
    string(REPLACE "\"" "\\\"" literal "${literal}")
    string(REPLACE "\n" "\\n\"\n        \"" literal "${literal}")
    set(${output} "\"${literal}\"" PARENT_SCOPE)
endfunction()

function(bs_embed_catalog kind extension)
    set(source "${CMAKE_CURRENT_SOURCE_DIR}/core/catalog/${kind}.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" contents)
    string(JSON count LENGTH "${contents}")
    math(EXPR last "${count} - 1")
    if(extension)
        set(declaration "static const catalog_extension extra[] = {\n")
    else()
        set(declaration "static const char *const catalog_${kind}[] = {\n")
    endif()
    if(count GREATER 0)
        foreach(index RANGE ${last})
            if(extension)
                string(JSON entry_kind GET "${contents}" ${index} kind)
                string(JSON field GET "${contents}" ${index} field)
                bs_catalog_string("${field}" literal)
                string(APPEND declaration "    {\"${entry_kind}\", ${literal}},\n")
            else()
                string(JSON field GET "${contents}" ${index})
                bs_catalog_string("${field}" literal)
                string(APPEND declaration "    ${literal},\n")
            endif()
        endforeach()
    endif()
    string(APPEND declaration "};\n")
    set(BS_EMBEDDED_CATALOG "${declaration}")
    configure_file(
        "${CMAKE_CURRENT_SOURCE_DIR}/core/catalog/catalog.h.in"
        "${CMAKE_CURRENT_BINARY_DIR}/catalog/${kind}.h" @ONLY
    )
endfunction()

foreach(kind IN ITEMS board component device signal test parameter formula step document)
    bs_embed_catalog(${kind} FALSE)
endforeach()
bs_embed_catalog(extra TRUE)
